rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Alle dürfen lesen, nur der Orga-Account darf schreiben
    match /boerdecup/{dokument} {
      allow read: if true;
      allow write: if request.auth != null
                   && request.auth.token.email == "soesterhc@soester-boerdecup.de";
    }
    match /{alles=**} {
      allow read, write: if false;
    }
  }
}




