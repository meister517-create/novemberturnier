 "info": [
  {
   "id": "n1",
   "title": "Hallen",
   "text": "Damen spielen am Samstag in Halle Ost, Herren in Halle West.\nAm Sonntag laufen die Damen-Platzierungsrunde und die Damen-Halbfinals in Halle Ost. Alle Spiele um Platz 3 und beide Finals finden in Halle West statt.\nHalle Ost ist am Sonntag ab 15:00 Uhr anderweitig belegt."
  },
  {
   "id": "n2",
   "title": "Spielzeiten",
   "text": "Damen: 25 Minuten Spielzeit, 5 Minuten Wechsel.\nHerren: 20 Minuten Spielzeit, 5 Minuten Wechsel.\nSamstag ab 9:30 Uhr, Sonntag ab 9:00 Uhr. Das letzte Spiel, das Herrenfinale, endet gegen 16:00 Uhr."
  },
  {
   "id": "n3",
   "title": "Spielmodus",
   "text": "Damen spielen in zwei Gruppen zu je fünf Teams, Herren in zwei Gruppen zu je sechs Teams, jeweils jeder gegen jeden.\nWertung: Punkte (Sieg 3, Unentschieden 1), Tordifferenz, erzielte Tore, direkter Vergleich.\nDie Ersten und Zweiten jeder Gruppe spielen über Kreuz die Halbfinals, danach Spiel um Platz 3 und Finale. Steht es dort nach der Spielzeit unentschieden, entscheidet ein 7-m-Schießen.\nAlle anderen Teams spielen in der Platzierungsrunde je zwei Spiele gegen Teams der anderen Gruppe und spielen so die übrigen Plätze aus."
  },
  {
   "id": "n4",
   "title": "Veranstalter",
   "text": "TSC Eintracht Dortmund Hockey\nVictor-Toyka-Straße 6, 44139 Dortmund"
  }
 ]
